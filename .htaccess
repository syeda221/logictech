# ── Force Directory Index to Laravel Front Controller ──
DirectoryIndex index.php

# ── Disable Phusion Passenger / Node.js Engine ──
<IfModule mod_passenger.c>
    PassengerEnabled off
    PassengerAppType none
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Handle Authorization Header for APIs & Auth
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Block direct access to hidden/sensitive files and directories
    RewriteRule ^(\.git|\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L,NC]

    # 3. Always route /vendor and /warehouse routes to Laravel index.php (even though physical folders exist)
    RewriteRule ^vendor(/.*)?$ index.php [L,QSA,NC]
    RewriteRule ^warehouse(/.*)?$ index.php [L,QSA,NC]

    # 4. Serve existing physical files directly (CSS, JS, Images, Uploads)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Fallback for uploads located in public/uploads
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # 6. Route all other requests through Laravel's index.php (without !-d check so routes matching folder names work)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# ── Security & MIME Types ──
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
